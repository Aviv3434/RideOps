generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  COMPANY_ADMIN
  CLIENT_USER
}

enum TripStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

model TransportationCompany {
  id       String  @id @default(uuid())
  name     String
  email    String?
  phone    String?
  isActive Boolean @default(true)

  users   User[]
  clients Client[]
  trips   Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transportation_companies")
}

model Client {
  id                      String @id @default(uuid())
  transportationCompanyId String

  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  isActive     Boolean @default(true)

  transportationCompany TransportationCompany @relation(fields: [transportationCompanyId], references: [id])

  users User[]
  trips Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transportationCompanyId])
  @@map("clients")
}

model User {
  id                      String @id @default(uuid())
  transportationCompanyId String
  clientId                String?

  email        String
  passwordHash String
  fullName     String
  role         UserRole
  isActive     Boolean @default(true)

  lastLoginAt DateTime?

  transportationCompany TransportationCompany @relation(fields: [transportationCompanyId], references: [id])
  client                Client?               @relation(fields: [clientId], references: [id])

  createdTrips   Trip[] @relation("TripCreatedBy")
  approvedTrips  Trip[] @relation("TripApprovedBy")
  rejectedTrips  Trip[] @relation("TripRejectedBy")
  cancelledTrips Trip[] @relation("TripCancelledBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transportationCompanyId, email])
  @@index([transportationCompanyId])
  @@index([clientId])
  @@index([role])
  @@map("users")
}

model Trip {
  id                      String @id @default(uuid())
  transportationCompanyId String
  clientId                String

  tripNumber Int

  pickupDateTime DateTime
  pickupLocation String
  destination    String
  passengerCount Int
  notes          String?

  status TripStatus @default(PENDING_APPROVAL)

  duplicateWarning Boolean @default(false)
  isExported Boolean @default(false)

  rejectionReason String?

  createdByUserId   String?
  approvedByUserId  String?
  rejectedByUserId  String?
  cancelledByUserId String?

  approvedAt  DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?
  exportedAt DateTime?

  transportationCompany TransportationCompany @relation(fields: [transportationCompanyId], references: [id])
  client                Client                @relation(fields: [clientId], references: [id])

  createdByUser   User? @relation("TripCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUser  User? @relation("TripApprovedBy", fields: [approvedByUserId], references: [id])
  rejectedByUser  User? @relation("TripRejectedBy", fields: [rejectedByUserId], references: [id])
  cancelledByUser User? @relation("TripCancelledBy", fields: [cancelledByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transportationCompanyId, tripNumber])

  @@index([transportationCompanyId])
  @@index([clientId])
  @@index([status])
  @@index([pickupDateTime])
  @@index([duplicateWarning])
  @@index([isExported])

  @@map("trips")
}