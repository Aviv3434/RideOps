generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  COMPANY_ADMIN
  CLIENT_USER
}

model TransportationCompany {
  id       String  @id @default(uuid())
  name     String
  email    String?
  phone    String?
  isActive Boolean @default(true)

  users   User[]
  clients Client[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transportation_companies")
}

model Client {
  id                      String @id @default(uuid())
  transportationCompanyId String

  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  isActive     Boolean @default(true)

  transportationCompany TransportationCompany @relation(fields: [transportationCompanyId], references: [id])

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transportationCompanyId])
  @@map("clients")
}

model User {
  id                      String @id @default(uuid())
  transportationCompanyId String
  clientId                String?

  email        String
  passwordHash String
  fullName     String
  role         UserRole
  isActive     Boolean @default(true)

  lastLoginAt DateTime?

  transportationCompany TransportationCompany @relation(fields: [transportationCompanyId], references: [id])
  client                Client?               @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transportationCompanyId, email])
  @@index([transportationCompanyId])
  @@index([clientId])
  @@index([role])
  @@map("users")
}